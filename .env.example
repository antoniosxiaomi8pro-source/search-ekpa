# Αντίγραψέ το σε .env για τοπική εκτέλεση.
# Στο Railway, ΔΕΝ ανεβάζεις .env — τα ίδια ονόματα μεταβλητών μπαίνουν στο
# Project → Variables tab. Το Railway ορίζει μόνο του το PORT, μην το βάζεις εσύ.

# --- LLM provider ---
LLM_PROVIDER=anthropic
# Χρειάζεται μόνο το key του provider που θα χρησιμοποιήσεις πραγματικά.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- CORS ---
# Comma-separated λίστα από domains που επιτρέπεται να καλούν το /api/search και
# /api/chat. Χωρίς αυτό, πέφτει στα defaults μέσα στο server.js.
ALLOWED_ORIGINS=https://elearningekpa.gr,https://www.elearningekpa.gr

# --- Rate limiting (προαιρετικό, έχει λογικά defaults) ---
CHAT_RATE_LIMIT_PER_MIN=20
SEARCH_RATE_LIMIT_PER_MIN=120
ADMIN_RATE_LIMIT_PER_MIN=10

# --- Admin panel (taxonomy editor) ---
# Μυστικό password που θα βάζεις στο admin-taxonomy.html για να αποθηκεύσεις αλλαγές.
# Διάλεξε κάτι μεγάλο/τυχαίο (π.χ. με έναν password generator), όχι απλή λέξη.
# Αν λείπει αυτή η μεταβλητή, το admin panel είναι εντελώς κλειδωμένο (fail-closed).
ADMIN_TOKEN=

# --- Railway-specific (μην τα ορίζεις χειροκίνητα — τα προσθέτει αυτόματα το
# Railway αν ενεργοποιήσεις "Public Networking" στο service) ---
# RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
