# Αντίγραψέ το σε .env για τοπική εκτέλεση.
# Στο Railway, ΔΕΝ ανεβάζεις .env — τα ίδια ονόματα μεταβλητών μπαίνουν στο
# Project → Variables tab. Το Railway ορίζει μόνο του το PORT, μην το βάζεις εσύ.

# --- LLM provider ---
LLM_PROVIDER=anthropic
# Χρειάζεται μόνο το key του provider που θα χρησιμοποιήσεις πραγματικά.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- CORS ---
# Comma-separated λίστα από ΑΛΛΑ sites που επιτρέπεται να καλούν το API (π.χ. το GTM
# widget στο elearningekpa.gr). Οι σελίδες του ίδιου του backend (index.html, admin)
# επιτρέπονται πάντα αυτόματα (same-origin) — δεν χρειάζεται να μπει εδώ το δικό του URL.
# Χωρίς αυτό, πέφτει στα defaults μέσα στο server.js.
ALLOWED_ORIGINS=https://elearningekpa.gr,https://www.elearningekpa.gr
# Προαιρετικό: το δημόσιο URL του backend (π.χ. αν υπάρχει proxy που αλλάζει το Host header).
# PUBLIC_BASE_URL=https://search-api.elearningekpa.gr

# --- Rate limiting (προαιρετικό, έχει λογικά defaults) ---
CHAT_RATE_LIMIT_PER_MIN=20
SEARCH_RATE_LIMIT_PER_MIN=120
ADMIN_RATE_LIMIT_PER_MIN=10
TRACK_RATE_LIMIT_PER_MIN=120

# --- Μόνιμα δεδομένα (ΣΗΜΑΝΤΙΚΟ για production) ---
# Φάκελος όπου γράφονται τα αρχεία που αλλάζουν ενώ τρέχει ο server: concepts.json
# (αλλαγές από το admin panel) και analytics.json. Πρέπει να είναι ΕΚΤΟΣ του κώδικα:
#  - Railway: mount ενός Volume (π.χ. /data) και DATA_DIR=/data — αλλιώς χάνονται σε κάθε redeploy
#  - Δικός σας server: π.χ. /var/lib/ekpa-smart-finder — αλλιώς το `git pull` συγκρούεται με τις αλλαγές
# Στο πρώτο ξεκίνημα το concepts.json αντιγράφεται αυτόματα από το public/concepts.json.
# Αν μείνει κενό: παλιά συμπεριφορά (public/concepts.json + server/analytics.json).
DATA_DIR=
# Μέγιστος αριθμός διαφορετικών queries που κρατάει το analytics.json
ANALYTICS_MAX_QUERIES=2000

# --- Admin panel (taxonomy editor) ---
# Μυστικό password που θα βάζεις στο admin-taxonomy.html για να αποθηκεύσεις αλλαγές.
# Διάλεξε κάτι μεγάλο/τυχαίο (π.χ. με έναν password generator), όχι απλή λέξη.
# Αν λείπει αυτή η μεταβλητή, το admin panel είναι εντελώς κλειδωμένο (fail-closed).
ADMIN_TOKEN=

# --- Railway-specific (μην τα ορίζεις χειροκίνητα — τα προσθέτει αυτόματα το
# Railway αν ενεργοποιήσεις "Public Networking" στο service) ---
# RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
